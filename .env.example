# Copia este archivo como .env.local y completa los valores.
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy. Es pública: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nombre del bucket de Storage (debe coincidir con supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_BUCKET=productos

# Número de WhatsApp para el botón "Consultar" (código de país, sin + ni espacios). Opcional.
NEXT_PUBLIC_WHATSAPP=51999999999
